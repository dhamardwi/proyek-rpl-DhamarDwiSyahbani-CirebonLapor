generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===========================================================
// ENUMS (SQLite stores these as TEXT with validation in app)
// ===========================================================

// model Role mapped as string enum
// Values: MASYARAKAT | PETUGAS | ADMIN

// model DamageLevel mapped as string enum
// Values: UNKNOWN | RINGAN | SEDANG | BERAT | KRITIS

// model Priority mapped as string enum
// Values: RENDAH | SEDANG | TINGGI | KRITIS

// model ReportStatus mapped as string enum
// Values: MENUNGGU_VERIFIKASI | DIPROSES_AI | DITERIMA | DITOLAK | DITUGASKAN | SEDANG_DIPERBAIKI | SELESAI

// model ImageType mapped as string enum
// Values: KERUSAKAN | BUKTI_PERBAIKAN

// ===========================================================
// USER
// ===========================================================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("MASYARAKAT") // MASYARAKAT | PETUGAS | ADMIN
  isActive  Boolean  @default(true) @map("is_active")
  phone     String?  @map("phone")
  address   String?  @map("address")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  reports               Report[]                  @relation("Pelapor")
  assignments           Report[]                  @relation("PetugasDitugaskan")
  statusUpdates         ReportStatusHistory[]
  notifications         Notification[]
  whatsappLink          WhatsappLink?
  whatsappRegistrations WhatsappRegistration[]
  duplicateReviews      ReportDuplicateAnalysis[] @relation("DuplicateReviewer")

  @@map("users")
}

// ===========================================================
// FACILITY TYPE
// ===========================================================

model FacilityType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  reports Report[]

  @@map("facility_types")
}

// ===========================================================
// REPORT
// ===========================================================

model Report {
  id          String   @id @default(cuid())
  title       String
  description String?
  damageType  String?  @map("damage_type") // Jenis kerusakan spesifik (teks bebas/AI)
  damageLevel String   @default("UNKNOWN") @map("damage_level") // UNKNOWN | RINGAN | SEDANG | BERAT | KRITIS
  priority    String   @default("RENDAH") @map("priority") // RENDAH | SEDANG | TINGGI | KRITIS
  latitude    Float?
  longitude   Float?
  address     String
  status      String   @default("MENUNGGU_VERIFIKASI") // MENUNGGU_VERIFIKASI | DIPROSES_AI | DITERIMA | DITOLAK | DITUGASKAN | SEDANG_DIPERBAIKI | SELESAI
  aiAnalysis  String?  @map("ai_analysis") // JSON: { category, damageLevel, priority, reasoning }
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Foreign keys
  userId         String  @map("user_id")
  assignedTo     String? @map("assigned_to")
  facilityTypeId String  @map("facility_type_id")

  // Relations
  user                User                      @relation("Pelapor", fields: [userId], references: [id])
  assignee            User?                     @relation("PetugasDitugaskan", fields: [assignedTo], references: [id])
  facilityType        FacilityType              @relation(fields: [facilityTypeId], references: [id])
  images              ReportImage[]
  statusHistory       ReportStatusHistory[]
  duplicateAnalyses   ReportDuplicateAnalysis[] @relation("DuplicateReport")
  duplicateCandidates ReportDuplicateAnalysis[] @relation("DuplicateCandidate")

  @@index([status])
  @@index([priority])
  @@index([userId])
  @@index([assignedTo])
  @@index([facilityTypeId])
  @@map("reports")
}

// ===========================================================
// REPORT IMAGE
// ===========================================================

model ReportImage {
  id        String   @id @default(cuid())
  imagePath String   @map("image_path")
  imageType String   @default("KERUSAKAN") @map("image_type") // KERUSAKAN | BUKTI_PERBAIKAN
  // Perceptual hash (dHash) untuk deteksi gambar duplikat.
  imageHash String?  @map("image_hash")
  createdAt DateTime @default(now()) @map("created_at")

  // Foreign keys
  reportId String @map("report_id")

  // Relations
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([imageHash])
  @@map("report_images")
}

// ===========================================================
// REPORT STATUS HISTORY
// ===========================================================

model ReportStatusHistory {
  id        String   @id @default(cuid())
  status    String // Snapshot status saat perubahan terjadi
  note      String? // Catatan perubahan (opsional)
  createdAt DateTime @default(now()) @map("created_at")

  // Foreign keys
  reportId    String @map("report_id")
  updatedById String @map("updated_by")

  // Relations
  report    Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  updatedBy User   @relation(fields: [updatedById], references: [id])

  @@map("report_status_histories")
}

// ===========================================================
// NOTIFICATION
// ===========================================================

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  link      String?
  // Kunci idempotensi per penerima, mis. "report-created:<id>:<userId>".
  // NULL diizinkan berulang pada SQLite; nilai unik mencegah notifikasi ganda.
  eventKey  String?  @unique @map("event_key")
  createdAt DateTime @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

// ===========================================================
// WHATSAPP LINK (satu akun aplikasi <-> satu nomor WhatsApp aktif)
// Hanya dibuat setelah OTP berhasil diverifikasi.
// ===========================================================

model WhatsappLink {
  id          String   @id @default(cuid())
  // Nomor ternormalisasi format internasional, mis. 6281234567890.
  phoneNumber String   @unique @map("phone_number")
  verifiedAt  DateTime @default(now()) @map("verified_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("whatsapp_links")
}

// ===========================================================
// WHATSAPP REGISTRATION (pengajuan nomor + persetujuan admin)
// Status persetujuan: PENDING | APPROVED | REJECTED
// Status akhir:      VERIFIED | CANCELLED
// Persetujuan admin TIDAK sama dengan status verifikasi OTP.
// ===========================================================

model WhatsappRegistration {
  id              String    @id @default(cuid())
  phoneNumber     String    @map("phone_number")
  // PENDING | APPROVED | REJECTED | VERIFIED | CANCELLED
  status          String    @default("PENDING")
  rejectionReason String?   @map("rejection_reason")
  reviewedBy      String?   @map("reviewed_by")
  reviewedAt      DateTime? @map("reviewed_at")
  otpSentAt       DateTime? @map("otp_sent_at")
  otpSendError    String?   @map("otp_send_error")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  userId String       @map("user_id")
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  otp    WhatsappOtp?

  @@index([status, createdAt])
  @@index([userId, status])
  @@map("whatsapp_registrations")
}

// ===========================================================
// WHATSAPP OTP (sekali pakai, kedaluwarsa, disimpan sebagai hash)
// Tabel ini tidak pernah menyimpan OTP mentah.
// ===========================================================

model WhatsappOtp {
  id         String    @id @default(cuid())
  otpHash    String    @map("otp_hash")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  usedAt     DateTime? @map("used_at")
  lastSentAt DateTime? @map("last_sent_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  registrationId String               @unique @map("registration_id")
  registration   WhatsappRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("whatsapp_otps")
}

// ===========================================================
// WHATSAPP OUTBOX (antrean pengiriman + retry + deduplikasi)
// ===========================================================

model WhatsappOutbox {
  id            String    @id @default(cuid())
  dedupeKey     String    @unique @map("dedupe_key")
  phoneNumber   String    @map("phone_number")
  message       String
  // PENDING | PROCESSING | SENT | FAILED
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  sentAt        DateTime? @map("sent_at")
  userId        String?   @map("user_id")

  @@index([status, nextAttemptAt])
  @@index([userId])
  @@map("whatsapp_outbox")
}

// ===========================================================
// APP SETTINGS (key-value)
// Menyimpan konfigurasi aplikasi yang diatur Admin, termasuk AI.
// API key AI disimpan TERENKRIPSI dengan prefix "enc:v1:".
// Diakses lewat SQL parameterized (bukan Prisma model) agar format
// `updated_at` epoch-ms yang sudah ada tetap kompatibel.
// ===========================================================

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @map("updated_at")

  @@map("app_settings")
}

// ===========================================================
// REPORT DUPLICATE ANALYSIS
// Hasil pemeriksaan duplikat antara laporan baru dan kandidat.
// ===========================================================

model ReportDuplicateAnalysis {
  id                String    @id @default(cuid())
  reportId          String    @map("report_id")
  candidateReportId String    @map("candidate_report_id")
  similarityScore   Float     @default(0) @map("similarity_score")
  descriptionScore  Float     @default(0) @map("description_score")
  titleScore        Float     @default(0) @map("title_score")
  categoryScore     Float     @default(0) @map("category_score")
  locationScore     Float     @default(0) @map("location_score")
  photoScore        Float?    @map("photo_score")
  distanceMeters    Float?    @map("distance_meters")
  isPotential       Boolean   @default(false) @map("is_potential")
  aiStatus          String    @default("PENDING") @map("ai_status") // PENDING | DONE | FAILED
  adminStatus       String    @default("PENDING") @map("admin_status") // PENDING | CONFIRMED | REJECTED
  aiAnalysis        String?   @map("ai_analysis")
  adminNote         String?   @map("admin_note")
  reviewedBy        String?   @map("reviewed_by")
  reviewedAt        DateTime? @map("reviewed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  report    Report @relation("DuplicateReport", fields: [reportId], references: [id], onDelete: Cascade)
  candidate Report @relation("DuplicateCandidate", fields: [candidateReportId], references: [id], onDelete: Cascade)
  reviewer  User?  @relation("DuplicateReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@unique([reportId, candidateReportId])
  @@index([reportId, isPotential])
  @@index([candidateReportId])
  @@index([adminStatus])
  @@map("report_duplicate_analyses")
}
