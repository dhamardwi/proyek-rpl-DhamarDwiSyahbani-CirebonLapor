# Database (SQLite, path relatif terhadap folder prisma)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="ganti-dengan-string-acak-panjang"

# URL publik aplikasi. Dipakai untuk tautan detail laporan di pesan Telegram.
APP_URL="http://localhost:3000"

# Telegram Bot
TELEGRAM_BOT_TOKEN="8786923825:AAFLfvL5G_DtApXV4fmus9KBqjMm0iUojYY"
TELEGRAM_BOT_USERNAME="SistemLaporanNotifikasi_bot"
TELEGRAM_NOTIFICATIONS_ENABLED="true"

# Wajib untuk webhook. Buat string acak, lalu daftarkan dengan script
# `npm run telegram:webhook` (secret yang sama dikirim ke Telegram).
TELEGRAM_WEBHOOK_SECRET="ganti-dengan-secret-acak-minimal-32-karakter"

# Mode pengembangan tanpa URL publik. Bila true, bot mengambil update lewat
# getUpdates secara otomatis saat `npm run dev`/`next start` (webhook tidak perlu).
TELEGRAM_USE_POLLING="false"

# Opsional: melindungi endpoint /api/telegram/worker untuk cron retry.
# Jika kosong, endpoint worker dinonaktifkan (pengiriman tetap lewat `after`).
TELEGRAM_WORKER_SECRET="ganti-dengan-secret-acak-lainnya"

# ============================================================================
# Konfigurasi AI (opsional — dapat diatur lewat Admin > Konfigurasi AI)
# ============================================================================
# Nilai di bawah hanya fallback. Konfigurasi yang disimpan Admin di database
# selalu diutamakan. API key dari halaman Admin disimpan terenkripsi.
#
# NVIDIA NIM (chatbot)
# NVIDIA_API_KEY="nvapi-..."
# NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
# NVIDIA_MODEL="openai/gpt-oss-20b"
##
# Secret untuk enkripsi API key di database. Jika kosong, NEXTAUTH_SECRET
# dipakai. Sebaiknya diisi string acak yang stabil di production.
# AI_CONFIG_SECRET="ganti-dengan-string-acak-panjang"

# ============================================================================
# Konfigurasi jaringan Node.js untuk Telegram Bot API (penting!)
# ============================================================================
# Di beberapa jaringan (termasuk Windows/Laragon), koneksi IPv4 ke
# https://api.telegram.org gagal (TLS timeout / connection reset) sementara
# IPv6 berhasil. Node.js fetch harus dipaksa menggunakan DNS IPv6 terlebih
# dahulu dengan menambahkan NODE_OPTIONS ke dalam environment saat menjalankan
# server, atau langsung melalui skrip `dev` di package.json.
#
# Contoh Windows PowerShell:
#   $env:NODE_OPTIONS="--dns-result-order=ipv6first --no-network-family-autoselection"
#   npm run dev
#
# Atau tambahkan langsung ke skrip dev di package.json (sudah diterapkan):
#   "dev": "cmd /c \"set NODE_OPTIONS=--dns-result-order=ipv6first --no-network-family-autoselection && next dev\""
#
# Skrip di atas menggunakan cmd /c agar kompatibel dengan Windows PowerShell.
# Untuk production (`next start`), tetapkan NODE_OPTIONS di environment
# deployment sebelum menjalankan server.
#
# Perhatian: --no-network-family-autoselection menonaktifkan fallback ke IPv4.
# Jika lingkungan deployment tidak memiliki IPv6, hapus flag ini dan gunakan
# hanya --dns-result-order=ipv6first agar Happy Eyeballs tetap mencoba IPv4.
#
# JANGAN mengatur NODE_TLS_REJECT_UNAUTHORIZED=0 atau menonaktifkan
# validasi sertifikat SSL.
