# Database (SQLite, path relatif terhadap folder prisma)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="ganti-dengan-string-acak-panjang"

# URL publik aplikasi. Dipakai untuk tautan detail laporan di pesan WhatsApp.
APP_URL="http://localhost:3000"

# ============================================================================
# Notifikasi WhatsApp (Fonnte)
# ============================================================================
# Token device Fonnte. JANGAN commit token asli ke repository.
FONNTE_API_TOKEN="token-device-fonnte-anda"
FONNTE_API_URL="https://api.fonnte.com/send"
FONNTE_COUNTRY_CODE="62"

# Opsional. Set "false" untuk menonaktifkan kanal WhatsApp tanpa menghapus
# konfigurasi. Notifikasi in-app tetap berjalan.
# FONNTE_NOTIFICATIONS_ENABLED="true"

# Opsional (dipakai tes). Set "false" agar outbox tidak diproses otomatis
# setelah response; worker dapat dipicu manual dari kode.
# WHATSAPP_AUTO_PROCESS="true"

# ============================================================================
# Konfigurasi AI (opsional — dapat diatur lewat Admin > Konfigurasi AI)
# ============================================================================
# Nilai di bawah hanya fallback. Konfigurasi yang disimpan Admin di database
# selalu diutamakan. API key dari halaman Admin disimpan terenkripsi.
#
# NVIDIA NIM (chatbot)
# NVIDIA_API_KEY="nvapi-..."
# NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
# NVIDIA_MODEL="openai/gpt-oss-20b"
##
# Secret untuk enkripsi API key di database. Jika kosong, NEXTAUTH_SECRET
# dipakai. Sebaiknya diisi string acak yang stabil di production.
# AI_CONFIG_SECRET="ganti-dengan-string-acak-panjang"
